# ==========================================
# Virtual Environment
# ==========================================
venv/
env/
ENV/
.venv/

# ==========================================
# Python Bytecode & Cache
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# IDE & Editor Files (Mac & VS Code)
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
.vscode/
.idea/

# ==========================================
# Local Data & Sample Files
# (Prevents uploading real CVs / JDs to Git)
# ==========================================
sample_cvs/*.pdf
sample_cvs/*.docx
sample_cvs/*.txt
jds/*.pdf
jds/*.docx
jds/*.txt

# Keep the directory structure in Git, but ignore contents
!sample_cvs/.gitkeep
!jds/.gitkeep

# ==========================================
# Hugging Face Model Cache & Outputs
# ==========================================
.cache/
*.log

# ==========================================
# Environment & Secrets
# ==========================================
.env
.env.local
.env.production

# ==========================================
# Node.js (Frontend)
# ==========================================
node_modules/
.next/
out/
.vercel/

# ==========================================
# ATS Scorer Specific / Obsidian
# ==========================================
docs/
scratch/
tests/
.vercel
.env*
